+#ifdef UNPIN_MULTICALL
+/* The folded `diff' lives in this binary as the renamed entry point diff_main
+   named by the fold (UNPIN_ENTRY_DIFF).  diff3/sdiff run it IN-PROCESS instead of
+   execvp-ing an external `diff', so the single multicall binary stays
+   standalone.  With a working fork (GNU/Linux, macOS) we run diff_main in a
+   forked child for free state isolation; without fork (native Windows / mingw)
+   we capture diff's stdout to a temp file and call diff_main directly in this
+   process.  UNPIN_TEST_NOFORK forces the fork-free path even where fork exists,
+   so it can be exercised on a POSIX dev box.  */
+/* The fold keeps exactly one symbol per program external -- the entry -- so
+   that is the only name a sibling applet can call.  The build passes it as
+   UNPIN_ENTRY_DIFF (nix-lib's lib.multicallEntrySym), which is why no spelling
+   of it appears here.  envp goes unread: diff's main takes (argc, argv), and
+   the entry only forwards a third argument nothing looks at -- we are the same
+   process, with the same environment, either way.  */
+#ifndef UNPIN_ENTRY_DIFF
+# error "UNPIN_MULTICALL without UNPIN_ENTRY_DIFF"
+#endif
+extern int UNPIN_ENTRY_DIFF (int, char **, char **);
+#define diff_main(c, v) UNPIN_ENTRY_DIFF ((c), (v), 0)
