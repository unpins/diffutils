+# if ! HAVE_WORKING_FORK || defined UNPIN_TEST_NOFORK
+#  define UNPIN_INPROC_NOFORK 1
+/* Fresh temp file for the fork-free capture.  Returns an fd; stores the
+   malloc'd path in *NAME, to be unlinked + freed AFTER the fd is closed (native
+   Windows cannot unlink an open file).  gnulib mkstemp in the temp dir.  The
+   dir is $TMPDIR (POSIX) or $TMP / $TEMP (Windows), else P_tmpdir -- mingw's
+   P_tmpdir is the drive root "\\", unusable, so the Windows vars come first.  */
+static int
+unpin_diff_capture_fd (char **name)
+{
+  char const *dir = getenv ("TMPDIR");
+  if (! (dir && *dir)) dir = getenv ("TMP");
+  if (! (dir && *dir)) dir = getenv ("TEMP");
+  if (! (dir && *dir)) dir = P_tmpdir;
+  char *buf = xmalloc (strlen (dir) + sizeof "/unpin-diffXXXXXX");
+  strcpy (stpcpy (buf, dir), "/unpin-diffXXXXXX");
+  int fd = mkstemp (buf);
+  if (fd < 0)
+    {
+      free (buf);
+      *name = nullptr;
+    }
+  else
+    *name = buf;
+  return fd;
+}
+# endif
+#endif
